class Solution:
    def rotate(self, nums: list[int], k: int) -> None:
        k = k%len(nums)

        self.rotateRight(nums,0,len(nums)-1)
        self.rotateRight(nums,0,k-1)
        self.rotateRight(nums,k,len(nums)-1)

    def rotateRight(self,nums,start,end):
        while(start<=end):
            temp = nums[start]
            nums[start] = nums[end]
            nums[end] = temp
            start += 1
            end -= 1
