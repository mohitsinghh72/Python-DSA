class Solution:
    def majorityElement(self, nums: list[int]) -> int:
        count = 0
        maxele = 0

        for i in range(0,len(nums)):
            if count == 0:
                maxele = nums[i]
                count+=1
            elif maxele == nums[i]:
                count+=1
            else:
                count -=1
        return maxele
        
